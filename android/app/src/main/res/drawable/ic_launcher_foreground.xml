<?xml version="1.0" encoding="utf-8"?>
<!--
  Octop 启动图标前景：白色圆环 O + 触手。
  造型取自本体 dashboard/public/favico.svg（红底白 mark），
  配色对齐本体红 #F44040 + 白色。所有坐标落在 108 画布中心 66×66 安全区内（28~80 / 32~72）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 圆环 O：圆心偏左 (46,54)，外半径 18，6 单位圆头描边 -->
    <path
        android:pathData="M46,36 a18,18 0 1,1 0,36 a18,18 0 1,1 0,-36"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- 触手：从 O 右侧伸出的圆头线，呼应 favico 里的白色胶囊触手 -->
    <path
        android:pathData="M64,54 L80,54 M64,48 L78,40 M64,60 L78,68 M78,40 L78,32"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
