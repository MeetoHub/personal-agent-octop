<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 明暗双模：windowBackground 透明，首帧由 MainActivity 根布局按主题铺 Bg；
         状态栏/导航栏图标明暗由 MainActivity.applySystemBarAppearance 运行时设置，
         故此处不写死 windowLightStatusBar / windowLightNavigationBar，避免浅色模式启动闪黑。 -->
    <style name="Theme.OctopMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
